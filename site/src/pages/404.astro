---
import '../styles/global.css';
---

<!doctype html>
<html lang="pt-BR" style="--B:#1F4FE0;--I:#FFFFFF">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Página não encontrada | KM 360</title>
    <link rel="icon" href="/favicon.png" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&display=swap" />
  </head>
  <body>
    <main class="block" style="min-height:100svh;display:grid;align-content:center;gap:1.25rem">
      <p class="kicker">Erro 404 · KM 360</p>
      <h1 class="h2">Essa página não existe.</h1>
      <p class="lede">O endereço pode ter mudado. Volte para o início ou faça o diagnóstico grátis da sua loja.</p>
      <p style="display:flex;flex-wrap:wrap;gap:.6rem;margin-top:.5rem">
        <a class="btn btn-primary" href="/">Ir para o início</a>
        <a class="btn" href="/#diagnostico">Fazer diagnóstico</a>
        <a class="btn" href="/es/">Ver en español</a>
      </p>
    </main>
  </body>
</html>
