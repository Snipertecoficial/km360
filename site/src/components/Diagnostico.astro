---
import { copy, marketplaces, WHATSAPP, type Lang } from '../data/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = copy[lang].diag;
---

<section class="block diag" id="diagnostico" aria-labelledby="diag-title">
  <form class="diag-form inv" data-lang={lang} novalidate>
    <div class="diag-head">
      <h2 id="diag-title" class="diag-title">{d.title}</h2>
      <p class="diag-scarcity">{d.scarcity}</p>
    </div>

    <fieldset>
      <legend>{d.q1.label}</legend>
      <div class="chips">
        {d.q1.options.map((o) => <label class="chip"><input type="radio" name="seg" value={o} required /><span>{o}</span></label>)}
      </div>
    </fieldset>

    <fieldset>
      <legend>{d.q2.label}</legend>
      <div class="chips">
        {d.q2.options.map((o) => <label class="chip"><input type="radio" name="fat" value={o} required /><span>{o}</span></label>)}
      </div>
    </fieldset>

    <fieldset>
      <legend>{d.q3.label}</legend>
      <div class="chips">
        {marketplaces.map((m) => (
          <label class="chip" style={`--accent:${m.accent}`}><input type="checkbox" name="mkt" value={m.name} /><span><i class="dot" aria-hidden="true"></i>{m.name}</span></label>
        ))}
        <label class="chip"><input type="checkbox" name="mkt" value={d.q3.none} data-none /><span>{d.q3.none}</span></label>
      </div>
    </fieldset>

    <label class="field">
      <span>{d.name.label}</span>
      <input type="text" name="name" autocomplete="given-name" placeholder={d.name.placeholder} maxlength="60" />
    </label>

    <label class="sim-attach" hidden>
      <input type="checkbox" name="sim" />
      <span>{d.sim}<small data-sim-text></small></span>
    </label>

    <p class="diag-error" role="alert" tabindex="-1" hidden>{d.error}</p>
    <button type="submit" class="btn btn-primary">{d.submit} <span class="arr" aria-hidden="true">→</span></button>
    <p class="diag-note">{d.note}</p>
    <noscript><a class="btn" href={`https://wa.me/${WHATSAPP}`}>WhatsApp</a></noscript>
  </form>
</section>

<script>
  import { whatsappUrl, parseOrigin, type Lang, type Sim } from '../data/content';

  // Origem do contato: vale a da primeira entrada com campanha nesta sessão; vai junto na mensagem.
  let origin = parseOrigin(location.search);
  try {
    origin = sessionStorage.getItem('km360-origem') || origin;
    if (origin) sessionStorage.setItem('km360-origem', origin);
  } catch { /* sem storage: usa só a URL atual */ }

  // Pixel do Meta, GA4 e GTM ainda não instalados (IDs com o cliente). Quando entrarem, este envio já conta como lead.
  type Tags = { dataLayer?: object[]; fbq?: (...a: unknown[]) => void; gtag?: (...a: unknown[]) => void };
  function trackLead() {
    const w = window as Tags;
    w.dataLayer?.push({ event: 'diagnostico_whatsapp', origem: origin });
    w.fbq?.('track', 'Contact');
    w.gtag?.('event', 'generate_lead');
  }

  document.querySelectorAll<HTMLFormElement>('.diag-form').forEach((form) => {
    const error = form.querySelector<HTMLElement>('.diag-error')!;
    const none = form.querySelector<HTMLInputElement>('[data-none]')!;
    const boxes = [...form.querySelectorAll<HTMLInputElement>('input[name="mkt"]')];
    const simBox = form.querySelector<HTMLInputElement>('input[name="sim"]')!;

    // "Ainda não vendo" exclui os marketplaces e vice-versa.
    boxes.forEach((b) =>
      b.addEventListener('change', () => {
        if (!b.checked) return;
        if (b === none) boxes.forEach((o) => o !== none && (o.checked = false));
        else none.checked = false;
      }),
    );

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = new FormData(form);
      let sim: Sim | undefined;
      if (simBox.checked && simBox.value) {
        try { sim = JSON.parse(simBox.value); } catch { sim = undefined; }
      }
      const url = whatsappUrl(form.dataset.lang as Lang, {
        name: String(f.get('name') ?? ''),
        seg: (f.get('seg') as string) || undefined,
        fat: (f.get('fat') as string) || undefined,
        mkt: boxes.filter((b) => b.checked).map((b) => b.value),
        sim,
        origin,
      });
      error.hidden = !!url;
      if (url) { trackLead(); window.open(url, '_blank', 'noopener'); }
      else error.focus();
    });
  });
</script>
